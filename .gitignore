# Dependencies
node_modules/
apps/*/node_modules
packages/*/node_modules
package-lock.json
yarn.lock

# Next.js / TypeScript output
.next/
apps/*/.next
build/
dist/
coverage/
tsconfig.tsbuildinfo

# Local environment
.e2e-slot
.env*
!.env.example
!ops/monitoring/stub/.env.*
**/env.prod
!**/env.prod.example
apps/web/env.local
apps/web/.env.local
apps/admin/.env.local
packages/shared/.env.local
*.log

# OS/editor metadata
.DS_Store
**/.DS_Store
.idea/
.cursor/

# Local agent/tool state
.code-review-graph/
.codex/
.understand-anything/intermediate/
.understand-anything/diff-overlay.json
.understand-anything/tmp/

# Java / Maven / Ant build output
target/
**/target/
*.class
*.war
*.ear

# Archives generated during local experiments
*.zip
*.tar
*.tar.gz
*.tgz

.planning/

.playwright-mcp/

review/screenshots/
.vercel

# Local DB backups / dumps (contain real data — never commit)
ops/backups/

# TLS private keys and certificates (never commit PEM material)
ops/deploy/ssl/*.pem
ops/deploy/ssl/**/*.pem
**/privkey.pem
**/fullchain.pem
!ops/deploy/tls/archives/*-fullchain.pem
!ops/deploy/tls/production-inventory.json

# App log files (ADR 0004; contain phones/OTPs — never commit)
/logs/

# Generated by Next on dev/build/typegen
apps/*/next-env.d.ts
