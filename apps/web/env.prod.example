# ─── Production Environment — Vesta v1 (template) ────────────────────────────
# Copy to env.prod and fill in real values. Never commit env.prod.
# Sync production values via the Vercel dashboard (cycle-circle project).

# App
APP_URL=https://your-app.example.com
NODE_ENV=production

# Database — Supabase
# Pooler (Transaction mode) — used by the app at runtime
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct — used for prisma migrate deploy
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis — optional for v1 (in-memory fallback if unset)
# REDIS_URL=

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=GENERATE-WITH-openssl-rand-hex-32
# Web session cookie (default in code; set explicitly in Vercel for clarity)
AUTH_COOKIE_NAME=vesta_token
# Cron routes — generate with: openssl rand -hex 16
CRON_SECRET=GENERATE-WITH-openssl-rand-hex-16

# Email — Resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Vesta <noreply@your-domain.com>
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# BDApps — production credentials from BDApps developer portal
BDAPPS_APP_ID=YOUR_BDAPPS_APP_ID
BDAPPS_PASSWORD=YOUR_BDAPPS_PASSWORD
# Do NOT set BDAPPS_BASE_URL — defaults to https://developer.bdapps.com
# Do NOT set simulator vars in production

# Webhooks — BDApps callback IPs (comma-separated)
BDAPPS_WEBHOOK_IPS=

# Dev flags — must be false/unset in real production
# DEV_MODE=true
# NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_USE_DUMMY_DATA=false

# ─── Local cron worker — NOT used in production ────────────────────────────────
# In production, Vercel Cron POSTs to /api/cron/daily-reminders (08:00 UTC) and
# /api/cron/caas-check (02:00 UTC). Do NOT deploy or run the BullMQ worker process
# in a production environment — set the cron schedule in vercel.json instead.
# WORKER_TARGET_URL=  # not applicable in production
# REMINDERS_CRON=     # not applicable in production (use vercel.json crons)
# CAAS_CRON=          # not applicable in production (use vercel.json crons)
# RUN_ON_BOOT=false
