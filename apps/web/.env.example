# ─── Local development (hybrid: Docker infra + Next.js on host) ───────────────
# Copy to .env.local: cp .env.example .env.local
# Or run: just setup

APP_URL=http://localhost:3000
NODE_ENV=development

# Database — Docker postgres (host port 5431)
DATABASE_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev
DIRECT_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev

# Redis — Docker redis (optional; in-memory fallback if unset)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=local-dev-jwt-secret-minimum-32-characters-long
# Per-app auth cookie name — web uses vesta_token; admin overrides to vesta_admin_token so both sessions coexist on localhost
AUTH_COOKIE_NAME=vesta_token
CRON_SECRET=local-cron-secret

# Email — Mailpit (Docker SMTP + web UI on :8025)
MAILPIT_SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=  # optional in local dev

# BDApps simulator (Docker bdapps-simulator service)
BDAPPS_APP_ID=APP_SIMULATOR
BDAPPS_PASSWORD=simulator_password
BDAPPS_SIMULATOR_BASE_URL=http://127.0.0.1:7002
BDAPPS_SIMULATOR_UI_URL=http://localhost:10001/mchoice-tap-sdk
BDAPPS_SIMULATOR_CALLBACK_BASE_URL=http://host.docker.internal:3000
ENABLE_BDAPPS_SIMULATOR_CHECKER=true

# Dev mode: OTP bypass codes 420420 / 840840 (never enable in production)
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_USE_DUMMY_DATA=false

# ─── Local cron worker (just worker / docker worker service) ───
# WORKER_TARGET_URL=http://localhost:3000
# REMINDERS_CRON=0 8 * * *
# CAAS_CRON=0 2 * * *
# RUN_ON_BOOT=false
