# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BDApps simulator checker: local-only tool for /internal/simulator-check.
# Host-run Next.js app -> Dockerized API simulator REST.
BDAPPS_SIMULATOR_BASE_URL="http://127.0.0.1:7010"
BDAPPS_SIMULATOR_UI_URL="http://localhost:10001/mchoice-tap-sdk"

# Real BDApps callback URL base used to derive /api/webhooks/* callback targets.
# Host-run app usually uses http://localhost:3000; Dockerized simulators use host.docker.internal.
BDAPPS_WEBHOOK_BASE_URL="http://host.docker.internal:3000"

# Optional per-webhook overrides. These win over BDAPPS_WEBHOOK_BASE_URL.
# BDAPPS_SMS_RECEIVE_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/sms/receive"
# BDAPPS_SMS_REPORT_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/sms/report"
# BDAPPS_USSD_RECEIVE_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/ussd/receive"
# BDAPPS_SUBSCRIPTION_NOTIFY_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/subscription/notify"
# BDAPPS_CAAS_NOTIFY_WEBHOOK_URL="http://host.docker.internal:3000/api/webhooks/caas/notify"

# URL the simulator checker capture routes should use when calling back into the host Next.js app.
# It is also the fallback base for real callback URLs when BDAPPS_WEBHOOK_BASE_URL is unset.
# If the app runs inside the same Compose network, use http://app:3000 instead.
BDAPPS_SIMULATOR_CALLBACK_BASE_URL="http://host.docker.internal:3000"
ENABLE_BDAPPS_SIMULATOR_CHECKER="true"

# UI data source: true = offline fixtures + bypassed auth, false = PostgreSQL via API (default)
# Restart dev server after changing NEXT_PUBLIC_* vars.
NEXT_PUBLIC_USE_DUMMY_DATA=false

# Dev mode: OTP flow uses codes 420420/840840 instead of BDApps SMS (set both; blocked in production)
# DEV_MODE=true
# NEXT_PUBLIC_DEV_MODE=true
