# ─── Production Environment — Vesta v1 ───────────────────────────────────────
# IMPORTANT: Do NOT commit this file. It is gitignored.
# Copy relevant values to Vercel dashboard → Environment Variables.

# App
APP_URL=https://vesta-app.com
NODE_ENV=production

# Database — Supabase (project: acuvzhyerxikdbcadkrr, region: ap-northeast-2)
# Pooler (Transaction mode) — used by the app at runtime
DATABASE_URL=postgresql://postgres.acuvzhyerxikdbcadkrr:v3oQtnke9hUSHGwf@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct — used for prisma migrate deploy
DIRECT_URL=postgresql://postgres:v3oQtnke9hUSHGwf@db.acuvzhyerxikdbcadkrr.supabase.co:5432/postgres

# Redis — NOT required for v1 (in-memory fallback)
# REDIS_URL=

# Auth — REPLACE these with real secrets before deploy
JWT_SECRET=GENERATE-WITH-openssl-rand-hex-32
CRON_SECRET=GENERATE-WITH-openssl-rand-hex-16

# Email — Resend (free tier: 3k/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@vesta-app.com

# BDApps — production credentials (obtain from BDApps portal)
BDAPPS_APP_ID=
BDAPPS_PASSWORD=
# Do NOT set BDAPPS_BASE_URL — defaults to https://developer.bdapps.com
# Do NOT set simulator vars in production

# Webhooks — set to BDApps callback IPs (comma-separated)
BDAPPS_WEBHOOK_IPS=

# Dev flags — all OFF in production
# DEV_MODE=false
# NEXT_PUBLIC_DEV_MODE=false
# NEXT_PUBLIC_USE_DUMMY_DATA=false
