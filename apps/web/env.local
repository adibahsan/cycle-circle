# App
APP_URL=http://localhost:3000

# Database (5431 = docker-compose-dev host port)
DATABASE_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev

# Redis
REDIS_URL=redis://localhost:6379

# BDApps (uses local simulator)
BDAPPS_APP_ID=APP_SIMULATOR
BDAPPS_PASSWORD=simulator_password
BDAPPS_BASE_URL=https://developer.bdapps.com
BDAPPS_SIMULATOR_BASE_URL=http://127.0.0.1:7002
BDAPPS_SIMULATOR_UI_URL=http://localhost:10001/mchoice-tap-sdk
BDAPPS_SIMULATOR_CALLBACK_BASE_URL=http://host.docker.internal:3000
ENABLE_BDAPPS_SIMULATOR_CHECKER=true

# Auth
JWT_SECRET=local-dev-jwt-secret-minimum-32-characters-long-enough
PRISMA_FIELD_ENCRYPTION_KEY=k1.aesgcm256.local-dev-encryption-key-32b=

# Cron
CRON_SECRET=local-cron-secret-min-16

# Email (Mailpit in dev, Resend in prod)
RESEND_API_KEY=
MAILPIT_SMTP_URL=smtp://localhost:1025
MAILPIT_UI_URL=http://localhost:8025

# Webhooks (empty = allow all in dev)
BDAPPS_WEBHOOK_IPS=

NODE_ENV=development

# UI data source: true = offline fixtures, false = PostgreSQL via API (default)
# Restart dev server after changing NEXT_PUBLIC_* vars.
NEXT_PUBLIC_USE_DUMMY_DATA=false

# Dev login: skip OTP but use real DB (set both; ignored in production)
DEV_MODE=true
NEXT_PUBLIC_DEV_MODE=true
