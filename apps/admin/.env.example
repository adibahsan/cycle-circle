# ─── Admin local development ──────────────────────────────────────────────────
# Copy to .env.local: cp .env.example .env.local
# Or run: just setup
# Sessions are isolated per-app via AUTH_COOKIE_NAME (below) — admin no longer shares the web cookie.

DATABASE_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev
# Direct connection — used for prisma migrate deploy (bypasses PgBouncer)
DIRECT_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev

# Redis — optional; in-memory fallback if unset
# REDIS_URL=redis://localhost:6379

# Auth — must DIFFER from the web app's JWT_SECRET (ADR 0007)
JWT_SECRET=local-dev-admin-jwt-secret-minimum-32-characters
# Required; distinct from the web app's vesta_token so admin + web sessions can coexist on the same host
AUTH_COOKIE_NAME=vesta_admin_token
# Which environment this is: local | staging | production. Becomes the token issuer (vesta:<APP_ENV>).
APP_ENV=local

# Optional — email delivery status refresh on /emails
# RESEND_API_KEY=

# System page — manually trigger web-app cron jobs
# CRON_SECRET must match the web app's CRON_SECRET exactly
APP_URL=http://localhost:3000
CRON_SECRET=local-cron-secret

# ─── Seed ──────────────────────────────────────────────────────────────────────
# Uncomment to override the default admin credentials used during `just setup`.
# ⚠ Always set strong, unique values in staging / production.
# ADMIN_EMAIL=admin@vesta.health
# ADMIN_PASSWORD=admin123
