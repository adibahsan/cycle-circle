# ─── Admin local development ──────────────────────────────────────────────────
# Copy to .env.local: cp .env.example .env.local
# Or run: just setup
# Sessions are isolated per-app via AUTH_COOKIE_NAME (below) — admin no longer shares the web cookie.

DATABASE_URL=postgresql://vesta_user:vesta_dev@localhost:5431/vesta_dev
JWT_SECRET=local-dev-jwt-secret-minimum-32-characters-long
# Distinct from the web app's cookie (default vesta_token) so admin + web sessions can coexist on the same host
AUTH_COOKIE_NAME=vesta_admin_token

# Optional — email delivery status refresh on /emails
# RESEND_API_KEY=
