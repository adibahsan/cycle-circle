# ─── Production Environment — Vesta Admin v1 (template) ──────────────────────
# Copy to env.prod and fill in real values. Never commit env.prod.
# Sync production values via the Vercel dashboard (cycle-circle-admin project).

# App
NODE_ENV=production

# Database — Supabase
# Pooler (Transaction mode) — used by the app at runtime
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct — used for prisma migrate deploy (bypasses PgBouncer)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Redis — optional for v1 (in-memory fallback if unset)
# REDIS_URL=

# Auth — must DIFFER from the web app's JWT_SECRET (ADR 0007)
# Generate with: openssl rand -hex 32
JWT_SECRET=GENERATE-WITH-openssl-rand-hex-32
# Admin session cookie (required, no default) — distinct from the web app's vesta_token
AUTH_COOKIE_NAME=vesta_admin_token
# production | staging (never local; local-dev JWT secrets are refused outside local)
APP_ENV=production

# Web app — admin's System page triggers web cron jobs and cache revalidation
APP_URL=https://your-web-app.example.com
# Cron routes — must match the web app's CRON_SECRET exactly
# Generate with: openssl rand -hex 16
CRON_SECRET=GENERATE-WITH-openssl-rand-hex-16

# Email — optional; enables delivery status refresh on /emails
# RESEND_API_KEY=re_your_resend_api_key
