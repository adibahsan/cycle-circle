{
  "name": "@vesta/shared",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server/services": "./src/server/services/index.ts",
    "./server/adapters/*": "./src/server/adapters/*.ts",
    "./server/simulator/*": "./src/server/simulator/*.ts",
    "./server/*": "./src/server/*.ts",
    "./types": "./src/types/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./eslint/bangladesh-day": "./eslint/bangladesh-day.mjs",
    "./prisma": "./prisma/schema.prisma"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ./prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema ./prisma/schema.prisma",
    "db:seed": "prisma db seed --schema ./prisma/schema.prisma",
    "db:studio": "prisma studio --schema ./prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema ./prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "i18next": "^25.1.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "ioredis": "^5.10.1",
    "jose": "^6.2.3",
    "nodemailer": "^8.0.10",
    "react-i18next": "^15.4.0",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.39.5",
    "next": "^16.4.3",
    "prisma": "^6.19.3",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.1.7"
  }
}
