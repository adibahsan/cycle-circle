// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AuthMethod {
  OTP
  EMAIL
}

enum SubscriptionStatus {
  FREE
  PRO
  LAPSED
}

enum Language {
  EN
  BN
}

enum Role {
  USER
  ADMIN
}

enum ProfileRelation {
  SELF
  WIFE
  SISTER
  MOTHER
  DAUGHTER
  GIRLFRIEND
}

enum FlowIntensity {
  LIGHT
  MEDIUM
  HEAVY
}

enum SymptomCategory {
  PHYSICAL
  MOOD
  DISCHARGE
  LIFESTYLE
}

enum PredictionTier {
  AVERAGE
  ARIMA
  LSTM
}

enum FeedbackCategory {
  BUG
  FEATURE
  GENERAL
  SATISFACTION
}

enum WebhookType {
  SMS_RECEIVE
  SMS_REPORT
  USSD_RECEIVE
  SUBSCRIPTION_NOTIFY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String             @id @default(cuid())
  phone               String?            @unique
  email               String?            @unique
  fullName            String?
  authMethod          AuthMethod
  subscriptionStatus  SubscriptionStatus @default(FREE)
  language            Language           @default(EN)
  emailTrialExpiresAt DateTime?
  profileCompleted    Boolean            @default(false)
  role                Role               @default(USER)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  profiles      Profile[]
  subscriptions Subscription[]
  otpChallenges OtpChallenge[]
  magicLinks    MagicLink[]
  feedback      Feedback[]
}

model Profile {
  id              String          @id @default(cuid())
  userId          String
  name            String
  relation        ProfileRelation
  cycleLength     Int             @default(28)
  periodLength    Int             @default(5)
  lastPeriodStart DateTime?
  goal            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodLogs       PeriodLog[]
  symptomLogs      SymptomLog[]
  predictions      Prediction[]
  notificationPref NotificationPreference?
}

model PeriodLog {
  id            String        @id @default(cuid())
  profileId     String
  startDate     DateTime
  endDate       DateTime
  flowIntensity FlowIntensity
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model SymptomLog {
  id        String          @id @default(cuid())
  profileId String
  date      DateTime
  category  SymptomCategory
  symptomId String
  value     String
  createdAt DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
}

model Prediction {
  id              String         @id @default(cuid())
  profileId       String         @unique
  tier            PredictionTier
  nextPeriodStart DateTime
  ovulationDay    DateTime
  fertileStart    DateTime
  fertileEnd      DateTime
  confidence      Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  status                SubscriptionStatus @default(FREE)
  bdappsSubscriberId    String?
  paymentInstrumentName String?
  amount                Int?
  consecutiveFailures   Int                @default(0)
  gracePeriodEndsAt     DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  caasTransactions CaasTransaction[]
}

model CaasTransaction {
  id             String   @id @default(cuid())
  subscriptionId String?
  externalTrxId  String   @unique
  internalTrxId  String?
  referenceId    String?
  amount         Int
  status         String
  createdAt      DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model OtpChallenge {
  id          String   @id @default(cuid())
  userId      String?
  phone       String
  referenceNo String
  verified    Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}

model MagicLink {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id             String      @id @default(cuid())
  type           WebhookType
  payload        Json
  idempotencyKey String      @unique
  processedAt    DateTime?
  createdAt      DateTime    @default(now())
}

model JobEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model NotificationPreference {
  id              String  @id @default(cuid())
  profileId       String  @unique
  periodAlert     Boolean @default(true)
  fertileWindow   Boolean @default(true)
  loggingReminder Boolean @default(true)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String
  profileId String?
  category  FeedbackCategory
  message   String
  rating    Int?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
