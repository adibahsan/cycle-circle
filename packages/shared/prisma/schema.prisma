// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AuthMethod {
  OTP
  EMAIL
}

enum SubscriptionStatus {
  FREE
  PRO
  LAPSED
}

enum Language {
  EN
  BN
}

enum Role {
  USER
  ADMIN
}

enum ProfileRelation {
  SELF
  WIFE
  SISTER
  MOTHER
  DAUGHTER
  GIRLFRIEND
}

enum FlowIntensity {
  LIGHT
  MEDIUM
  HEAVY
}

enum SymptomCategory {
  PHYSICAL
  MOOD
  DISCHARGE
  LIFESTYLE
}

enum PredictionTier {
  AVERAGE
  ARIMA
  LSTM
}

enum FeedbackCategory {
  BUG
  FEATURE
  GENERAL
  SATISFACTION
}

enum WebhookType {
  SMS_RECEIVE
  SMS_REPORT
  USSD_RECEIVE
  SUBSCRIPTION_NOTIFY
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CyclePhase {
  MENSTRUAL
  FOLLICULAR
  OVULATION
  LUTEAL
}

enum SmsBroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum SmsSendLanguage {
  BN
  EN
  BOTH
}

enum EmailType {
  MAGIC_LINK
  PERIOD_ALERT
  FERTILE_ALERT
  LOGGING_REMINDER
  PROFILE_COMPLETION_REMINDER
}

enum EmailStatus {
  SENT
  FAILED
}

enum EmailProvider {
  RESEND
  SMTP
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  BOUNCED
  COMPLAINED
  DELAYED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                  String             @id @default(cuid())
  phone               String?            @unique
  email               String?            @unique
  fullName            String?
  passwordHash        String?
  authMethod          AuthMethod
  subscriptionStatus  SubscriptionStatus @default(FREE)
  language            Language           @default(EN)
  emailTrialExpiresAt DateTime?
  profileCompleted              Boolean            @default(false)
  profileReminderOptOut         Boolean            @default(false)
  onboardingTourCompletedAt     DateTime?
  role                     Role               @default(USER)
  suspendedAt         DateTime?
  suspendedBy         String?
  sessionsValidAfter  DateTime?
  deletedAt           DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  profiles        Profile[]
  subscriptions   Subscription[]
  otpChallenges   OtpChallenge[]
  magicLinks      MagicLink[]
  feedback        Feedback[]
  articles        Article[]
  smsBroadcasts   SmsBroadcast[]
  adminAuditLogs  AdminAuditLog[]
  emailLogs       EmailLog[]

  @@index([createdAt])
  @@index([lastLoginAt])
  @@index([deletedAt])
}

model Profile {
  id              String          @id @default(cuid())
  userId          String
  name            String
  relation        ProfileRelation
  cycleLength     Int             @default(28)
  periodLength    Int             @default(5)
  lastPeriodStart DateTime?
  goal            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodLogs       PeriodLog[]
  symptomLogs      SymptomLog[]
  predictions      Prediction[]
  notificationPref NotificationPreference?
  emailLogs        EmailLog[]
}

model PeriodLog {
  id            String        @id @default(cuid())
  profileId     String
  startDate     DateTime
  endDate       DateTime
  flowIntensity FlowIntensity
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Composite index: nearly every read filters by profile AND orders/ranges
  // by startDate (calendar, listPeriodLogs, insights, engagement, prediction).
  // The leftmost prefix still serves profileId-only lookups / cascade deletes.
  @@index([profileId, startDate])
}

model SymptomLog {
  id        String          @id @default(cuid())
  profileId String
  date      DateTime
  category  SymptomCategory
  symptomId String
  value     String
  createdAt DateTime        @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
}

model Prediction {
  id              String         @id @default(cuid())
  profileId       String         @unique
  tier            PredictionTier
  nextPeriodStart DateTime
  ovulationDay    DateTime
  fertileStart    DateTime
  fertileEnd      DateTime
  confidence      Float
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  status                SubscriptionStatus @default(FREE)
  bdappsSubscriberId    String?
  paymentInstrumentName String?
  amount                Int?
  adminOverride         Boolean            @default(false)
  adminOverrideBy       String?
  adminOverrideAt       DateTime?
  /// Revoke only: the BDApps unsubscribe failed, so a repeat REGISTERED must not end the override.
  adminOverrideUnsubFailed Boolean @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  caasTransactions CaasTransaction[]
}

model CaasTransaction {
  id             String   @id @default(cuid())
  subscriptionId String?
  externalTrxId  String   @unique
  internalTrxId  String?
  referenceId    String?
  amount         Int
  status         String
  createdAt      DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model OtpChallenge {
  id          String   @id @default(cuid())
  userId      String?
  phone       String
  referenceNo String
  verified    Boolean  @default(false)
  expiresAt   DateTime
  /// App OTP only (GLOSSARY): HMAC of the code we sent by SMS. Null for a BDApps OTP, which BDApps checks.
  codeHash    String?
  /// Wrong App OTP codes entered so far.
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}

model MagicLink {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WebhookEvent {
  id             String      @id @default(cuid())
  type           WebhookType
  payload        Json
  idempotencyKey String      @unique
  processedAt    DateTime?
  createdAt      DateTime    @default(now())
}

model JobEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  lastError   String?
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model NotificationPreference {
  id              String  @id @default(cuid())
  profileId       String  @unique
  periodAlert     Boolean @default(true)
  fertileWindow   Boolean @default(true)
  loggingReminder Boolean @default(true)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String
  profileId String?
  category  FeedbackCategory
  message   String
  rating    Int?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  titleEn     String
  titleBn     String?
  bodyEn      String        @db.Text
  bodyBn      String?       @db.Text
  status      ArticleStatus @default(DRAFT)
  categoryId  String?
  cyclePhases CyclePhase[]  @default([])
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([categoryId])
  @@index([authorId])
}

model ArticleCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  articles Article[]
}

model SmsBroadcast {
  id             String             @id @default(cuid())
  message        String
  messageBn      String?
  sendLanguage   SmsSendLanguage    @default(BOTH)
  scheduledFor   DateTime?
  sentAt         DateTime?
  status         SmsBroadcastStatus @default(DRAFT)
  // Content-override: only the latest sent daily content stays active/visible.
  active         Boolean            @default(true)
  // BDApps sms/send messageId, used to correlate inbound delivery reports.
  providerMessageId String?
  targetCount    Int?
  deliveredCount Int?
  failedCount    Int?
  // Send attempts since last (re)schedule; FAILED once it reaches the retry cap.
  sendAttempts   Int                @default(0)
  lastError      String?
  createdBy      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([scheduledFor])
  @@index([providerMessageId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model EmailLog {
  id             String         @id @default(cuid())
  type           EmailType
  to             String
  subject        String
  status         EmailStatus
  error          String?
  provider       EmailProvider
  resendId       String?
  deliveryStatus DeliveryStatus @default(PENDING)
  userId         String?
  profileId      String?
  sentAt         DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([to])
  @@index([type, profileId, sentAt])
  @@index([resendId])
  @@index([sentAt])
}

/// Per-cron on/off switch for scheduled (Vercel Cron) execution.
/// An absent row means the cron is enabled, so existing deployments keep
/// running with no behavior change. The manual "Run now" admin trigger bypasses
/// this flag via an explicit override.
model CronSetting {
  slug      String   @id // 'daily-reminders' | 'caas-check'
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String? // admin user id who last changed it
}
