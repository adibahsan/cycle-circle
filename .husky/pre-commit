# ESLint on staged files only (each file linted with its own package's config).
# Typecheck and tests are too slow for every commit: run what the change touches while
# developing, and the full set before a prod deploy (docs/LOCAL-DEVELOPMENT.md,
# "Checks before a deploy"; CI runs them only on a push to production).
pnpm exec lint-staged

# sed -i / merge leftovers (file-e, .orig, .bak) never get committed.
bash scripts/check-stray-files.sh --staged

# code-review-graph change summary (was in .git/hooks before husky took over core.hooksPath).
if command -v code-review-graph >/dev/null 2>&1; then
  code-review-graph detect-changes --brief || true
fi
