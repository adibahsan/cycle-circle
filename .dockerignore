# Git and editor
.git
.gitignore
**/.DS_Store
.cursor
.vscode
.idea

# Node / frontend (not needed for TAP simulator image)
node_modules
apps/*/node_modules
packages/*/node_modules
.pnpm-store
**/.next
**/dist
**/build
**/coverage
**/.turbo

# Logs and local simulator noise (smaller context, reproducible WAR)
# Runtime log output only. Not **/logs/**: Docker versions disagree on it, and
# the 2026-10-18 prod admin image shipped without the /logs page
# (apps/admin/src/app/(admin)/logs) -> 404 in prod.
logs
apps/*/logs
packages/*/logs
**/*.log
vendor/bdapps/sdk-standalone-1.2.68/**/*.war.bak

# Planning / docs not required in image context (optional speedup)
.planning

# Local secrets — prod uses build args + runtime env on the host
**/.env
**/.env.local
**/.env.*.local
