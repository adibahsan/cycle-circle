{
  "name": "vesta-workspace",
  "version": "1.5.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @vesta/web dev",
    "dev:admin": "pnpm --filter @vesta/admin dev",
    "build": "pnpm --filter @vesta/web build",
    "build:admin": "pnpm --filter @vesta/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @vesta/shared db:generate",
    "db:migrate": "pnpm --filter @vesta/shared db:migrate",
    "db:studio": "pnpm --filter @vesta/shared db:studio",
    "docs:sync": "node scripts/sync-netlify-docs.mjs --sync",
    "docs:check": "node scripts/sync-netlify-docs.mjs --check",
    "deploy:verify": "node scripts/verify-deploy-assets.mjs",
    "monitoring:verify": "node scripts/verify-monitoring-assets.mjs",
    "ops:test": "python3 -m unittest discover -s ops/monitoring/container-metrics-exporter && bash ops/deploy/scripts/test-install-vesta-crontab.sh",
    "ops:test:docker": "docker run --rm -v \"$PWD\":/w -w /w bash:5.2 bash ops/deploy/scripts/test-install-vesta-crontab.sh",
    "docker:monitoring": "docker compose -f ops/docker/compose.yml -f ops/monitoring/compose.yml -f ops/monitoring/compose.local.override.yml up -d",
    "docker:monitoring:down": "docker compose -f ops/docker/compose.yml -f ops/monitoring/compose.yml -f ops/monitoring/compose.local.override.yml down",
    "vps:preflight": "node scripts/verify-vps-preflight.mjs",
    "docker:dev": "docker compose -f ops/docker/compose.yml up -d --build",
    "docker:down": "docker compose -f ops/docker/compose.yml down",
    "docker:logs": "docker compose -f ops/docker/compose.yml logs -f",
    "docker:prod:build": "docker compose -f ops/deploy/compose.prod.yml build web admin"
  }
}
