# Install: crontab -u vesta /opt/vesta/ops/deploy/vesta-crontab
# Replace CRON_SECRET_PLACEHOLDER with the same value as CRON_SECRET in app env files.
# Server timezone should be UTC (see docs/ops/02-server-setup.md).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Daily reminders 08:00 UTC; CAAS check 02:00 UTC; (first two match apps/web/vercel.json)
# Nightly maintenance 02:30 UTC: MAE snapshot + purge of accounts deleted >30 days ago (host crontab only)
0 8 * * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" https://cycle-circle.com/api/cron/daily-reminders >> /var/log/vesta/cron-daily-reminders.log 2>&1
0 2 * * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" https://cycle-circle.com/api/cron/caas-check >> /var/log/vesta/cron-caas-check.log 2>&1
# SMS campaign dispatch every 15 minutes: sends today's message once the daily send time
# (System page, Bangladesh time) has passed, and marks missed days. Safe to repeat.
*/15 * * * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" https://cycle-circle.com/api/cron/sms-dispatch >> /var/log/vesta/cron-sms-dispatch.log 2>&1
30 2 * * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" https://cycle-circle.com/api/cron/nightly-maintenance >> /var/log/vesta/cron-nightly-maintenance.log 2>&1
# Pro subscriber snapshot 17:55 UTC (23:55 Bangladesh time): one count per Bangladesh day, for churn rate and estimated revenue
55 17 * * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" https://cycle-circle.com/api/cron/pro-snapshot >> /var/log/vesta/cron-pro-snapshot.log 2>&1
# Emailed Overview reports (recipients and on/off switch on the System page). Weekly: Sunday 03:00 UTC = 09:00 Bangladesh,
# covers the previous 7 Bangladesh days. Monthly: the 1st at 03:00 UTC = 09:00 Bangladesh, covers the previous calendar month.
# Each period is sent once, so a repeated hit is harmless.
0 3 * * 0 curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" "https://cycle-circle.com/api/cron/reports?kind=weekly" >> /var/log/vesta/cron-reports.log 2>&1
0 3 1 * * curl -fsS -X POST -H "Authorization: Bearer CRON_SECRET_PLACEHOLDER" "https://cycle-circle.com/api/cron/reports?kind=monthly" >> /var/log/vesta/cron-reports.log 2>&1

# TLS renewal (certbot no-ops unless cert expires within 30 days)
0 3,15 * * * cd /opt/vesta && sg docker -c 'docker compose -f ops/deploy/compose.prod.yml run --rm certbot renew --webroot -w /var/www/certbot --quiet && docker compose -f ops/deploy/compose.prod.yml exec -T nginx nginx -s reload' >> /var/log/vesta/certbot-renew.log 2>&1

# Nightly DB backup (see ops/deploy/scripts/backup-db.sh)
0 4 * * * /opt/vesta/ops/deploy/scripts/backup-db.sh >> /var/log/vesta/backup.log 2>&1
