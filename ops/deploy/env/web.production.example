# Copy to /opt/vesta/.env.web.production (chmod 600, owner vesta)
# See docs/ops/04-env-reference.md

APP_URL=https://cycle-circle.com
NODE_ENV=production

DATABASE_URL=postgresql://vesta:POSTGRES_PASSWORD_HERE@postgres:5432/vesta
DIRECT_URL=postgresql://vesta:POSTGRES_PASSWORD_HERE@postgres:5432/vesta
REDIS_URL=redis://redis:6379

# Must differ from the admin file's JWT_SECRET (ADR 0007).
JWT_SECRET=GENERATE-WITH-openssl-rand-hex-32
AUTH_COOKIE_NAME=vesta_token
# production, or staging on the staging box. Same value in the admin file. Becomes the token issuer.
APP_ENV=production
CRON_SECRET=GENERATE-WITH-openssl-rand-hex-16

RESEND_API_KEY=
RESEND_FROM_EMAIL=Cycle Circle <noreply@cycle-circle.com>
RESEND_WEBHOOK_SECRET=

BDAPPS_APP_ID=
BDAPPS_PASSWORD=
BDAPPS_WEBHOOK_IPS=

# Must stay false in production: deploy.sh refuses DEV_MODE=true, placeholder BDApps
# creds or a BDAPPS_SIMULATOR_BASE_URL (check-prod-env.sh; ALLOW_DEV_MODE=1 for staging only).
DEV_MODE=false
NEXT_PUBLIC_USE_DUMMY_DATA=false
