# Copy to ops/deploy/.env on the VPS. Loaded by docker compose for build-time values.

# Production: the web image must be built with dev mode OFF. deploy.sh refuses to deploy
# if this is true (ops/deploy/scripts/check-prod-env.sh); a staging box can override with
# ALLOW_DEV_MODE=1 bash ops/deploy/scripts/deploy.sh
NEXT_PUBLIC_DEV_MODE=false

# After Let's Encrypt issuance, switch nginx to TLS config:
# NGINX_CONF=cycle-circle.conf
