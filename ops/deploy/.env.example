# Copy to ops/deploy/.env on the VPS (optional). Loaded by docker compose for build-time overrides.

# Before real go-live, staging can use:
# NEXT_PUBLIC_DEV_MODE=true
# (requires rebuild: docker compose -f ops/deploy/compose.prod.yml build web)

# After Let's Encrypt issuance, switch nginx to TLS config:
# NGINX_CONF=cycle-circle.conf
